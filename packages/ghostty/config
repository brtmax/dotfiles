title = "Ghostty"

font-size = 13
mouse-hide-while-typing = true
window-theme = ghostty
confirm-close-surface = false

theme = ef-owl
shell-integration-features = no-cursor,sudo
window-colorspace = "display-p3"
background = 1C2021
adjust-cell-height = 35%

# Navigate window splits
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right

keybind = alt+e=new_split:right
keybind = alt+o=new_split:down

keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+l=resize_split:right,10

keybind = alt+shift+w=close_surface


background-opacity = 0.75
background-blur = 20
unfocused-split-opacity=0.6

clipboard-read = allow
clipboard-write = allow

shell-integration-features = true
cursor-style-blink = true
